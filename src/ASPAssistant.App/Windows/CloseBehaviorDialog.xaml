<Window x:Class="ASPAssistant.App.Windows.CloseBehaviorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭助手" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" Icon="{StaticResource AspaLogo}"
        PreviewKeyDown="OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Tag="{StaticResource IconClose}"
                            ToolTip="取消关闭" AutomationProperties.Name="取消关闭" Click="OnCancel"
                            Style="{StaticResource DialogCloseButton}" />
                    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitleText}" Text="关闭助手" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExitButton" Content="退出程序" Style="{StaticResource DialogDangerButton}" Click="OnExit" Margin="0,0,8,0" />
                    <Button x:Name="TrayButton" Content="收起到托盘" Style="{StaticResource DialogPrimaryButton}" Click="OnTray" IsDefault="True" />
                </StackPanel>
            </Border>
            <StackPanel Margin="16,14,16,16">
                <TextBlock x:Name="MessageText" Text="关闭主界面后，要如何处理？" TextWrapping="Wrap" FontSize="12" LineHeight="19" />
                <TextBlock x:Name="ExplanationText" Text="收起到托盘后，后台识别和快捷键继续运行；退出程序将停止后台识别。"
                           TextWrapping="Wrap" Margin="0,10,0,14" FontSize="12" LineHeight="19" Foreground="{DynamicResource TextSecondaryBrush}" />
                <CheckBox x:Name="RememberChoice" Content="记住我的选择，下次不再询问" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="SettingsHint" Text="之后可在“设置 → 界面 → 关闭行为”中修改。" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
